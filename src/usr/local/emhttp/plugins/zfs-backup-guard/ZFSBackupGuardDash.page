Title="ZFS Backup Guard"
Icon="shield"
Tag="shield"
Markdown="false"
---
<?php
require_once '/usr/local/emhttp/plugins/zfs-backup-guard/include/bootstrap.php';
$zbgDashEsc = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$zbgDashLabels = ['ok' => 'Geschützt', 'stale' => 'Überfällig', 'failed' => 'Fehlgeschlagen', 'never' => 'Noch kein Backup', 'disabled' => 'Pausiert', 'running' => 'Läuft'];
$zbgDashError = null;
$zbgDashRows = [];
try {
    foreach (\ZBG\JobStore::all() as $zbgDashJob) {
        $zbgDashStatus = \ZBG\History::status($zbgDashJob, \ZBG\History::forJob($zbgDashJob['id']));
        $zbgDashRun = \ZBG\RunState::read($zbgDashJob['id']);
        $zbgDashState = \ZBG\RunState::active($zbgDashJob['id']) ? 'running' : (($zbgDashRun['state'] ?? '') === 'running' ? 'failed' : $zbgDashStatus['state']);
        $zbgDashRows[] = ['job' => $zbgDashJob, 'state' => $zbgDashState, 'last' => $zbgDashStatus['lastSuccess']['end'] ?? null, 'step' => $zbgDashState === 'running' ? ($zbgDashRun['step'] ?? '') : ''];
    }
} catch (\Throwable $zbgDashException) {
    $zbgDashError = $zbgDashException->getMessage();
}
?>
<div class="zbg-dashboard">
  <?php if ($zbgDashError !== null): ?>
  <p role="alert"><?=$zbgDashEsc('Status nicht verfügbar: ' . $zbgDashError)?></p>
  <?php elseif ($zbgDashRows === []): ?>
  <p>Noch keine Backup-Jobs eingerichtet.</p>
  <?php else: ?>
  <table class="tablesorter" style="width:100%">
    <thead><tr><th>Job</th><th>Status</th><th>Letztes Backup</th></tr></thead>
    <tbody>
    <?php foreach ($zbgDashRows as $zbgDashRow): ?>
    <tr>
      <td><?=$zbgDashEsc($zbgDashRow['job']['name'])?><br><small><?=$zbgDashEsc($zbgDashRow['job']['source']['dataset'])?></small></td>
      <td><span style="color:<?=in_array($zbgDashRow['state'], ['failed'], true) ? '#dc2626' : ($zbgDashRow['state'] === 'stale' ? '#ca8a04' : ($zbgDashRow['state'] === 'ok' ? '#16a34a' : 'inherit'))?>"><?=$zbgDashEsc($zbgDashLabels[$zbgDashRow['state']] ?? 'Unbekannt')?></span><?php if ($zbgDashRow['step'] !== ''): ?><br><small><?=$zbgDashEsc($zbgDashRow['step'])?></small><?php endif; ?></td>
      <td><?=$zbgDashRow['last'] ? $zbgDashEsc(date('d.m.Y H:i', (int)$zbgDashRow['last'])) : '–'?></td>
    </tr>
    <?php endforeach; ?>
    </tbody>
  </table>
  <?php endif; ?>
  <p><a href="/Settings/ZFSBackupGuard">Backup-Jobs öffnen</a> · <a href="/Settings/ZFSBackupGuard#settings">Einstellungen</a></p>
</div>
